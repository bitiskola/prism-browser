{
  "name": "prism-browser",
  "productName": "Prism Browser",
  "version": "1.3.2",
  "desktopName": "prism-browser.desktop",
  "description": "A personal sandbox browser with search, proxy, Adblock Plus filtering and scoped page tools",
  "main": "electron/main.cjs",
  "private": true,
  "author": {
    "name": "Prism",
    "email": "prism-browser@invalid.example"
  },
  "homepage": "https://prism-browser.invalid/",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:integration": "node scripts/integration.cjs",
    "preview": "node scripts/preview.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:deb": "electron-builder --linux deb",
    "dist:win": "electron-builder --win nsis",
    "build:deb": "bash ./build_deb.sh",
    "build:win": "build_win.bat",
    "test:upgrade": "node scripts/upgrade-integration.cjs",
    "test:spoof": "node scripts/spoof-integration.cjs",
    "test:activation": "node scripts/focus-activation-integration.cjs",
    "test:frame-focus": "node scripts/frame-focus-integration.cjs",
    "test:spoof-ui": "node scripts/spoof-ui-regression.cjs",
    "test:favicons": "node scripts/favicon-integration.cjs",
    "test:ui": "node scripts/ui-regression.cjs",
    "test:desktop": "node scripts/desktop-integration.cjs",
    "test:typing": "node scripts/clipboard-typing-integration.cjs",
    "icons": "sh scripts/build-icons.sh"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "app.prism.browser",
    "productName": "Prism Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "COPYING",
      "THIRD_PARTY_NOTICES.md",
      "VALIDATION.md"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icons",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libfuse2"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  }
}
